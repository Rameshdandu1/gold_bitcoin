# Safe defaults: external ingest and paid analysis are OFF until enabled.
APP_NAME=Dual AI Market Intelligence
LIVE_INGESTION_ENABLED=false
AI_ENABLED=false
ALERTS_ENABLED=false
PAPER_COLLECTION_ENABLED=false
TRADING_ENABLED=false
# Phase 6 replay/paper acceptance is invoked explicitly through the bounded
# research CLI. It does not require enabling live ingestion, providers, alerts,
# paper collection, or trading.
DELTA_REST_URL=https://api.india.delta.exchange
DELTA_WS_URL=wss://public-socket.india.delta.exchange
BTC_SYMBOL=BTCUSD
# Validate this symbol exists in product discovery before enabling; may need PAXGUSD.
GOLD_SYMBOL=XAUTUSD
DATABASE_PATH=data/marketintel.sqlite3
# Both research stores must remain separate from DATABASE_PATH.
RESEARCH_DATABASE_PATH=data/research.sqlite3
PAPER_DATABASE_PATH=data/paper.sqlite3
DATA_MAX_AGE_SECONDS=180
DELTA_BOOK_MAX_AGE_SECONDS=10
# Bounded receive-to-disk decoupling. Exhaustion fails the collector closed; events are never dropped.
DELTA_PERSISTENCE_QUEUE_SIZE=8192
DELTA_PERSISTENCE_BATCH_SIZE=256
DELTA_DISCOVERY_REFRESH_SECONDS=300
DELTA_DISCOVERY_MAX_AGE_SECONDS=900
DELTA_RECONCILIATION_MAX_AGE_SECONDS=180
POLL_SECONDS=30
MAX_AI_CALLS_PER_DAY=50
MIN_REWARD_RISK=1.5
AI_TOTAL_DEADLINE_SECONDS=90
AI_ATTEMPT_TIMEOUT_SECONDS=25
AI_QUEUE_MAX_AGE_SECONDS=120
AI_JOB_LEASE_SECONDS=120
AI_MAX_ATTEMPTS_PER_PROVIDER=2
AI_MAX_INPUT_TOKENS=30000
AI_MAX_OUTPUT_TOKENS=650
AI_PROVIDER_CALL_LIMIT_PER_DAY=25
AI_TOTAL_CALL_LIMIT_PER_DAY=50
# Integer micro-USD. Keep zero until official rates and paid-call authorization are verified.
# Bounded smoke: `python -m marketintel.provider_smoke --authorize-paid-smoke`.
AI_TOTAL_COST_LIMIT_MICROUSD_PER_DAY=0
OPENAI_INPUT_MICROUSD_PER_MILLION_TOKENS=
OPENAI_OUTPUT_MICROUSD_PER_MILLION_TOKENS=
ANTHROPIC_INPUT_MICROUSD_PER_MILLION_TOKENS=
ANTHROPIC_OUTPUT_MICROUSD_PER_MILLION_TOKENS=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# No confirmation is eligible until explicit fee/slippage assumptions are supplied.
RISK_FEE_BPS=
RISK_SLIPPAGE_BPS=
RISK_MAXIMUM_ENTRY_DRIFT_BPS=10
RISK_MAXIMUM_SPREAD_BPS=10
RISK_MINIMUM_NET_REWARD_RISK=1.5
# HTTP Basic is a single-operator boundary and must be used only behind HTTPS/VPN externally.
OPERATOR_AUTH_ENABLED=true
OPERATOR_USERNAME=
OPERATOR_PASSWORD=
CORS_ALLOWED_ORIGINS_CSV=http://127.0.0.1:5173,http://localhost:5173
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Slack is optional. Authenticated dashboard-only decisions remain durable when alerts stay false.
ALERT_MAX_ATTEMPTS=3
ALERT_LEASE_SECONDS=30
COINGLASS_ENABLED=false
COINGLASS_API_KEY=
COINGLASS_BASE_URL=https://open-api-v4.coinglass.com
# Declared subscription gate: HOBBYIST|STARTUP|STANDARD|PROFESSIONAL|ENTERPRISE.
COINGLASS_PLAN=HOBBYIST
