# Safe defaults: external ingest and paid analysis are OFF until enabled.
APP_NAME=Dual AI Market Intelligence
LIVE_INGESTION_ENABLED=false
AI_ENABLED=false
TRADING_ENABLED=false
DELTA_REST_URL=https://api.india.delta.exchange
DELTA_WS_URL=wss://public-socket.india.delta.exchange
BTC_SYMBOL=BTCUSD
# Validate this symbol exists in product discovery before enabling; may need PAXGUSD.
GOLD_SYMBOL=XAUTUSD
DATABASE_PATH=data/marketintel.sqlite3
DATA_MAX_AGE_SECONDS=180
DELTA_BOOK_MAX_AGE_SECONDS=10
DELTA_DISCOVERY_REFRESH_SECONDS=300
POLL_SECONDS=30
MAX_AI_CALLS_PER_DAY=50
MIN_REWARD_RISK=1.5
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
COINGLASS_ENABLED=false
COINGLASS_API_KEY=
COINGLASS_BASE_URL=https://open-api-v4.coinglass.com
